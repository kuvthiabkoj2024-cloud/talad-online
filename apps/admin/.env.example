VITE_API_URL=http://localhost:4000/api/v1
# Customer storefront (apps/web), for "open in store" links
VITE_STOREFRONT_URL=http://localhost:3000

# Dev only: prefills the sign-in form with the seeded admin (services/api SEED_ADMIN_*); ignored in production builds
VITE_DEV_ADMIN_EMAIL=admin@talad.local
VITE_DEV_ADMIN_PASSWORD=ChangeMe123!

# Robot check on sign-in: Cloudflare Turnstile site key (TURNSTILE_SECRET_KEY on the API).
# Local testing: the always-pass test key 1x00000000000000000000AA. Unset = no check.
VITE_TURNSTILE_SITE_KEY=
