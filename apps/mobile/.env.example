# Use your machine's LAN IP (not localhost) when running on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# The storefront (apps/web): checkout and order details open there.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# The Seller Center (apps/shop): "Start your business" opens its sign-up.
EXPO_PUBLIC_SHOP_URL=http://localhost:5174

# Robot check on sign-in: the website's Cloudflare Turnstile site key (runs as EXPO_PUBLIC_SITE_URL).
# Unset = no check. Local testing can use the always-pass key 1x00000000000000000000AA.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
