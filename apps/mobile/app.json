{
  "expo": {
    "name": "MC Mart",
    "slug": "talad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcmart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a6d17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2e7d32",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MC Mart uses your location to pin your delivery address, so shops nearby can deliver for free."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "MC Mart uses your photos to set your profile picture, your refund QR code, and to search by photo.",
          "cameraPermission": "MC Mart uses the camera so you can search for products by taking a photo."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MC Mart uses the microphone so you can search by voice.",
          "speechRecognitionPermission": "MC Mart turns your voice into search words.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
