# Server-side base URL of the NestJS API
API_URL=http://localhost:4000/api/v1
# Seller center (apps/shop) — linked from "Sell on MC Mart"
NEXT_PUBLIC_SHOP_URL=http://localhost:5174

# Social sign-in (optional). Without these the buttons explain they aren't set up yet.
# Google: OAuth "Web application" client id — also set GOOGLE_CLIENT_ID on the API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple: Services ID + a registered https return URL — also set APPLE_CLIENT_ID on the API.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Bunny pull zone hostname (no https://) for optimized shop/product images
NEXT_PUBLIC_MEDIA_HOST=your-zone.b-cdn.net

# This site's public address: full links in share previews (Facebook, WhatsApp…)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Robot check on sign-in: Cloudflare Turnstile site key (TURNSTILE_SECRET_KEY on the API).
# Local testing: the always-pass test key 1x00000000000000000000AA. Unset = no check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret shared with the API (its INTERNAL_API_KEY): shoppers' IPs are passed on for per-shopper
# rate limits. Production sets it from infra/docker/.env.prod, never in .env.production (baked into the image).
INTERNAL_API_KEY=
