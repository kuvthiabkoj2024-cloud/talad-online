NODE_ENV=development
PORT=4000

# Matches infra/docker/docker-compose.yml
DATABASE_URL=postgresql://talad:talad@localhost:5433/talad?schema=public
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key-change-me

# Bunny storage zone for all uploads; layout in src/modules/media/storage-keys.ts.
# BUNNY_API_KEY is the storage zone password (Storage zone > FTP & API access).
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_BASE_HOSTNAME=sg.storage.bunnycdn.com
BUNNY_CDN_HOST=https://your-zone.b-cdn.net

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef

# web, admin, shop, expo web
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081

SEED_ADMIN_EMAIL=admin@talad.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Social sign-in: comma-separated client ids accepted as the ID-token audience
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
