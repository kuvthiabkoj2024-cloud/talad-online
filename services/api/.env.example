NODE_ENV=development
PORT=4000

# Matches infra/docker/docker-compose.yml
DATABASE_URL=postgresql://talad:talad@localhost:5433/talad?schema=public
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key-change-me

# Bunny storage zone for all uploads; layout in src/modules/media/storage-keys.ts.
# BUNNY_API_KEY is the storage zone password (Storage zone > FTP & API access).
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_BASE_HOSTNAME=sg.storage.bunnycdn.com
BUNNY_CDN_HOST=https://your-zone.b-cdn.net

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef

# web, admin, shop, expo web
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081
# Admin console, for password-reset links in emails
ADMIN_APP_URL=http://localhost:5173
SHOP_APP_URL=http://localhost:5174
# Behind a reverse proxy (nginx/Docker): proxy hops to trust for the client IP, e.g. 1 (empty = no proxy)
TRUST_PROXY=

SEED_ADMIN_EMAIL=admin@talad.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Telbiz SMS gateway for sign-in codes (empty: codes are only written to the API log)
TELBIZ_CLIENT_ID=
TELBIZ_SECRETKEY=

# Social sign-in: comma-separated client ids accepted as the ID-token audience
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Web Push (browser/PWA notifications): `npx web-push generate-vapid-keys` (empty: push is off)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@mcmart.app

# Outgoing email over SMTP (Gmail: smtp.gmail.com / 465 with an app password). Empty host: emails only go to the log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# New transfer orders to check are emailed here (comma-separated for several)
ADMIN_ORDER_EMAIL=paokue77@gmail.com

# Photo search (storefront scan): a local CLIP model indexes product photos (~90 MB download, once).
IMAGE_SEARCH_ENABLED=true
MODEL_CACHE_DIR=.cache/models
# Optional: with a key, Claude also describes scanned photos and adds keyword matches.
ANTHROPIC_API_KEY="key"
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: voice search understands Lao and English without choosing (Google Cloud Speech-to-Text
# API key: console.cloud.google.com → enable "Cloud Speech-to-Text API" → Credentials → API key).
GOOGLE_SPEECH_API_KEY=

# Robot check (Cloudflare Turnstile) on SMS codes, password sign-in and resets. Unset = off.
# dash.cloudflare.com → Turnstile → the widget's secret key. Local testing: the always-pass test
# secret 1x0000000000000000000000000000000AA (with site key 1x00000000000000000000AA in the apps).
TURNSTILE_SECRET_KEY=
# Shared with the storefront (apps/web INTERNAL_API_KEY): it then passes on shoppers' IPs so rate
# limits are per shopper. Production sets both from infra/docker/.env.prod. e.g. `openssl rand -hex 32`
INTERNAL_API_KEY=
